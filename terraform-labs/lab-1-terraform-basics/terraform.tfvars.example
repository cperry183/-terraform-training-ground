# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git

aws_region = "us-east-1"
environment = "dev"
instance_type = "t3.micro"

# REQUIRED: Replace with your EC2 Key Pair name
# Create one in AWS Console: EC2 -> Key Pairs -> Create key pair
key_name = "your-key-pair-name"

# Optional: Restrict SSH access by IP CIDR
# Default allows from anywhere (0.0.0.0/0)
# allowed_ssh_cidrs = ["1.2.3.4/32"]  # Your IP
